# Copy to .env. Never commit real credentials.
NODE_ENV=development
PORT=3000
DATABASE_PATH=./data/site.db
UPLOADS_DIR=./uploads
# Production: a persistent disk is required for BOTH the database and uploads.
# DATABASE_PATH=/app/data/site.db
# UPLOADS_DIR=/app/data/uploads
SITE_URL=http://localhost:3000
# Initial owner creation: set a real email and a unique password (at least 12 characters).
# Remove ADMIN_PASSWORD after first successful owner creation.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Set only if your deployment is behind exactly this number of trusted reverse proxies.
TRUST_PROXY=0
