<%- include('partials/head') %><%- include('partials/header') %>
<main id="main">
<% if(view==='home') { %>
<%- include('partials/hero') %>
<%- include('partials/offers') %>
<%- include('partials/services') %>
<%- include('partials/gallery') %>
<%- include('partials/compare') %>
<%- include('partials/why') %>
<%- include('partials/process') %>
<% if(settings.statsEnabled && Array.isArray(settings.statistics) && settings.statistics.length) { %><section class="statistics-section"><div class="container statistics-grid"><% settings.statistics.filter(stat=>stat.enabled!==false).forEach(stat=>{ %><article><span><b data-counter data-target="<%= Number(stat.value)||0 %>">0</b><%= stat.suffix || '' %></span><h2><%= stat.label %></h2></article><% }) %></div></section><% } %>
<%- include('partials/testimonials') %>
<%- include('partials/journal') %>
<%- include('partials/quote') %>
<%- include('partials/cta') %>
<% } else { %>
<%- include('partials/pagehead') %>
<% if(view==='services') { %><%- include('partials/services') %>
<% } else if(view==='projects') { %><%- include('partials/gallery') %>
<% } else if(view==='before-after') { %><%- include('partials/compare') %>
<% } else if(view==='testimonials') { %><%- include('partials/testimonials') %>
<% } else if(view==='blog') { %><%- include('partials/journal') %>
<% } else if(view==='quote') { %><%- include('partials/quote') %>
<% } else if(view==='contact') { %><%- include('partials/contact') %>
<% } else if(view==='about') { %>
<section class="section about-section"><div class="container about-layout"><div class="about-photo" data-reveal><img src="<%= (slides[0] || services[0] || {}).image || settings.ogImage %>" srcset="<%= srcsetFor((slides[0] || services[0] || {}).image || settings.ogImage) %>" sizes="(max-width: 700px) calc(100vw - 32px), 60vw" alt="مساحة منزلية هادئة بتشطيب متناسق — صورة إلهامية" width="1100" height="1300" loading="lazy" decoding="async"><span class="image-label">صورة إلهامية</span></div><div class="about-copy" data-reveal><p class="eyebrow">من نحن</p><h2>نعتني بمنزلك،<br>تفصيلًا بعد تفصيل.</h2><% String(settings.aboutText || settings.description).split(/\n{2,}/).forEach(p=>{ %><p><%= p %></p><% }) %><p>نخدم مدينة الرياض، مع التركيز على شمال الرياض. نبدأ بفهم احتياجات المساحة، ونناقش الألوان والخامات ونطاق التنفيذ للوصول إلى نتيجة تناسب ذوقك واحتياجك.</p><a class="button button-dark" href="/quote">دعنا نتعرف على مشروعك</a></div></div></section>
<%- include('partials/why') %><%- include('partials/process') %>
<% } else if(view==='service' && item) { %>
<section class="section detail-section"><div class="container detail-layout"><article class="reading-content"><img class="detail-cover" src="<%= item.image %>" srcset="<%= srcsetFor(item.image) %>" sizes="(max-width: 700px) calc(100vw - 32px), 60vw" alt="<%= item.data.alt || item.title %>" width="1200" height="760" loading="eager" decoding="async"><h2><%= item.title %> في الرياض</h2><% String(item.data.content || item.description).split(/\n{2,}/).forEach(p=>{ %><p><%= p %></p><% }) %>
<% if(item.data.features && item.data.features.length) { %><h2>ما الذي تشملُه الخدمة؟</h2><ul class="feature-list"><% item.data.features.forEach(feature=>{ %><li><%- include('partials/icon',{name:'check'}) %><%= feature %></li><% }) %></ul><% } %>
<% if(item.data.steps && item.data.steps.length) { %><h2>كيف نعمل؟</h2><ol class="reading-steps"><% item.data.steps.forEach(step=>{ %><li><%= typeof step==='string'?step:(step.title+' — '+step.text) %></li><% }) %></ol><% } %>
<h2>خدمة تناسب تفاصيل منزلك</h2><p>نعمل في شمال الرياض وجميع أحياء المدينة. يعتمد عرض السعر على مساحة العمل، وحالة الأسطح، والخامات المختارة. تواصل معنا لمناقشة التفاصيل والمعاينة عند الحاجة.</p></article><aside class="detail-sidebar"><div class="sidebar-cta"><p class="eyebrow">دعنا نبدأ</p><h2>تفاصيلك،<br>خطوتنا الأولى.</h2><p>أرسل صور المساحة أو اطلب عرض سعر يناسب مشروعك.</p><a class="button button-gold" href="<%= waUrl %>" target="_blank" rel="noopener noreferrer"><%- include('partials/icon',{name:'whatsapp'}) %> تواصل عبر واتساب</a><a class="button button-outline-dark" href="/quote">طلب عرض سعر</a><a href="<%= telUrl %>" dir="ltr" class="sidebar-phone"><%= settings.phone %></a></div><div class="related-services"><h2>خدمات أخرى</h2><% services.filter(s=>s.id!==item.id).slice(0,5).forEach(s=>{ %><a href="/services/<%= s.slug %>"><%= s.title %></a><% }) %></div></aside></div></section>
<% } else if(view==='project' && item) { %>
<section class="section detail-section"><div class="container"><% if(item.data.demo) { %><p class="gallery-note"><%- include('partials/icon',{name:'image'}) %> هذه مساحة إلهامية تُعرض لتوضيح الأفكار، ولا تمثل مشروعًا منفذًا للشركة.</p><% } %><div class="project-detail-grid"><article class="reading-content"><img class="detail-cover" src="<%= item.image %>" srcset="<%= srcsetFor(item.image) %>" sizes="(max-width: 700px) calc(100vw - 32px), 60vw" alt="<%= item.data.alt || item.title %>" width="1400" height="900" fetchpriority="high"><h2>عن المساحة</h2><% String(item.data.content || item.description).split(/\n{2,}/).forEach(p=>{ %><p><%= p %></p><% }) %></article><aside class="project-facts"><p class="eyebrow">تفاصيل المشروع</p><dl><% if(item.data.area) { %><div><dt>المنطقة</dt><dd><%= item.data.area %></dd></div><% } %><% if(item.data.district) { %><div><dt>الحي</dt><dd><%= item.data.district %></dd></div><% } %><div><dt>نوع الخدمة</dt><dd><%= item.data.service || item.data.category || 'ديكور داخلي' %></dd></div><% if(item.data.date) { %><div><dt>تاريخ التنفيذ</dt><dd><%= item.data.date %></dd></div><% } %></dl><a href="/quote" class="button button-dark">لديك مساحة مشابهة؟</a></aside></div>
<% if(item.data.images && item.data.images.length) { %><h2 class="project-gallery-heading">معرض الصور</h2><div class="project-photo-grid"><% item.data.images.forEach(photo=>{ %><a href="<%= typeof photo==='string'?photo:photo.url %>" data-lightbox data-title="<%= item.title %>"><img src="<%= typeof photo==='string'?photo:photo.url %>" srcset="<%= srcsetFor(typeof photo==='string'?photo:photo.url) %>" sizes="(max-width: 700px) calc(100vw - 32px), 60vw" alt="<%= typeof photo==='string'?item.title:(photo.alt || item.title) %>" loading="lazy" decoding="async" width="1000" height="750"></a><% }) %></div><% } %>
<% if(item.data.beforeImage && item.data.afterImage) { %><%- include('partials/compare',{comparisons:[{...item,data:{...item.data,beforeImage:item.data.beforeImage,afterImage:item.data.afterImage}}]}) %><% } %>
</div></section>
<% } else if(view==='article' && item) { %>
<section class="section"><div class="container article-layout"><article class="reading-content"><div class="article-meta"><span><%= item.data.author || settings.siteName %></span><% if(item.data.date && Number.isFinite(Date.parse(item.data.date))) { %><time datetime="<%= item.data.date %>"><%= new Intl.DateTimeFormat('ar-SA',{dateStyle:'long',calendar:'gregory'}).format(new Date(item.data.date)) %></time><% } %></div><img class="detail-cover" src="<%= item.image %>" srcset="<%= srcsetFor(item.image) %>" sizes="(max-width: 700px) calc(100vw - 32px), 60vw" alt="<%= item.data.alt || item.title %>" width="1200" height="800" fetchpriority="high"><% String(item.data.content || item.description).split(/\n{2,}/).forEach((p,i)=>{ if(p.startsWith('## ')) { %><h2><%= p.slice(3) %></h2><% } else { %><p><%= p %></p><% } }) %><div class="article-cta"><h2>فكرة اليوم قد تصبح مساحتك القادمة</h2><p>تواصل معنا لمناقشة الخامات والألوان ونطاق العمل المناسب لمنزلك في الرياض.</p><a class="button button-dark" href="/quote">طلب عرض سعر</a></div></article></div></section>
<% } else if(view==='area' && item) { %>
<section class="section"><div class="container detail-layout"><article class="reading-content"><h2>العناية بالمساحات في <%= item.title %></h2><% String(item.data.content || item.description).split(/\n{2,}/).forEach(p=>{ %><p><%= p %></p><% }) %><% if(item.data.highlights && item.data.highlights.length) { %><h2>قبل بدء أعمال التجديد</h2><ul class="feature-list"><% item.data.highlights.forEach(point=>{ %><li><%- include('partials/icon',{name:'check'}) %><%= point %></li><% }) %></ul><% } %><% if(item.data.faqs) { %><h2>أسئلة تهمك</h2><div class="faq-list"><% item.data.faqs.forEach(faq=>{ %><details><summary><%= faq.question %></summary><p><%= faq.answer %></p></details><% }) %></div><% } %></article><aside class="detail-sidebar"><div class="sidebar-cta"><p class="eyebrow">قريبون منك</p><h2>لمسة جديدة<br>لمنزلك في <%= item.title %>.</h2><a class="button button-gold" href="<%= waUrl %>" target="_blank" rel="noopener noreferrer">تواصل عبر واتساب</a><a class="button button-outline-dark" href="/quote">طلب عرض سعر</a></div></aside></div></section>
<% } else if(view==='notfound') { %><section class="section"><div class="container empty-state"><span class="error-code" dir="ltr">404</span><p>يمكنك العودة للرئيسية أو استكشاف خدمات الدهانات والديكور والتجديد.</p><a class="button button-dark" href="/">العودة للرئيسية</a></div></section><% } %>
<% if(!['quote','notfound'].includes(view)) { %><%- include('partials/cta') %><% } %>
<% } %>
<% if(areas.length && view==='home') { %><section class="areas-section"><div class="container"><p class="eyebrow">نطاق خدماتنا</p><h2>في شمال الرياض، وكل الرياض.</h2><p>دهانات، ديكورات وتجديد منازل قريب منك.</p><div class="areas-links"><% areas.forEach(area=>{ %><a href="/riyadh/<%= area.slug %>"><%- include('partials/icon',{name:'pin'}) %><%= area.title %></a><% }) %></div></div></section><% } %>
</main><%- include('partials/footer') %>