<%- include('partials/header', { pageTitle: 'تفاصيل الطلب' }) %>
<%
const info = request.data || {};
const requestFields = [['name','الاسم'],['phone','رقم الهاتف'],['whatsapp','رقم واتساب'],['email','البريد الإلكتروني'],['area','المنطقة'],['district','الحي'],['service','نوع الخدمة'],['propertyType','نوع العقار'],['budget','الميزانية التقريبية']];
const images = Array.isArray(info.photos) ? info.photos : Array.isArray(info.images) ? info.images : [];
const statusOptions = [['new','جديد'],['contacted','تم التواصل'],['quoted','تم إرسال العرض'],['completed','مكتمل'],['closed','مغلق']];
const contactNumber = String(info.whatsapp || info.phone || '').replace(/[^0-9]/g,'');
const whatsappNumber = contactNumber.startsWith('05') ? '966' + contactNumber.slice(1) : contactNumber;
%>
<div class="page-heading"><div><p class="eyebrow"><%= type === 'quotes' ? 'طلب عرض سعر' : 'رسالة تواصل' %></p><h1><%= info.name || 'تفاصيل الطلب' %></h1><p class="muted"><%= request.createdAt ? new Date(request.createdAt).toLocaleString('ar-SA') : '' %></p></div><a class="button button-outline" href="/admin/requests?type=<%= type %>">العودة إلى الطلبات</a></div>
<div class="editor-grid"><div class="editor-primary"><section class="panel"><div class="panel-heading"><h2>بيانات العميل</h2></div><dl class="detail-grid"><% requestFields.forEach(([key,label]) => { if (info[key]) { %><div><dt><%= label %></dt><dd <%= ['phone','whatsapp','email'].includes(key) ? 'dir=ltr' : '' %>><%= info[key] %></dd></div><% } }); %></dl></section>
<section class="panel"><div class="panel-heading"><h2><%= type === 'quotes' ? 'وصف العمل' : 'الرسالة' %></h2></div><p class="request-message"><%= info.description || info.message || 'لم يكتب العميل وصفًا إضافيًا.' %></p></section>
<% if (images.length) { %><section class="panel"><div class="panel-heading"><h2>الصور المرفقة</h2><span class="small-tag tag-light">خاصة</span></div><p class="field-note">هذه الصور متاحة لمسؤول الموقع فقط.</p><div class="request-photos"><% images.forEach(photo => { const filename = typeof photo === 'string' ? photo : photo.filename || photo.name || ''; if (filename) { %><a href="/admin/request-photos/<%= encodeURIComponent(filename.split('/').pop()) %>" target="_blank" rel="noopener"><img src="/admin/request-photos/<%= encodeURIComponent(filename.split('/').pop()) %>" alt="صورة أرفقها العميل" loading="lazy"></a><% } }); %></div></section><% } %>
</div><aside class="editor-aside"><section class="panel"><div class="panel-heading"><h2>متابعة الطلب</h2></div><form method="post" action="/admin/requests/<%= type %>/<%= request.id %>/status"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="field"><span>حالة الطلب</span><select name="status"><% statusOptions.forEach(([value,label]) => { %><option value="<%= value %>" <%= request.status === value ? 'selected' : '' %>><%= label %></option><% }); %></select></label><button class="button button-primary full-width" type="submit" data-submit-label="جارٍ الحفظ…">تحديث الحالة ✓</button></form></section><section class="panel"><div class="panel-heading"><h2>التواصل مع العميل</h2></div><% if (whatsappNumber) { %><a class="button button-whatsapp full-width" href="https://wa.me/<%= whatsappNumber %>?text=<%= encodeURIComponent('السلام عليكم، نتواصل معك من لمسة المستقبل بخصوص طلبك عبر الموقع.') %>" target="_blank" rel="noopener">فتح محادثة واتساب ↗</a><% } %><% if (info.phone) { %><a class="button button-outline full-width cancel-link" href="tel:<%= String(info.phone).replace(/[^+0-9]/g,'') %>">اتصال بالعميل</a><% } %><p class="field-note">يفتح الزر المحادثة لتراجع الرسالة وترسلها بنفسك.</p></section></aside></div>
<%- include('partials/footer') %>
