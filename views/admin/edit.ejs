<%- include('partials/header', { pageTitle: (newRecord ? 'إضافة' : 'تعديل') + ' · ' + collection.label }) %>
<%
const item = record || {};
const detail = item.data && typeof item.data === 'object' ? item.data : {};
const key = collection.key;
const isProject = key === 'projects';
const isBefore = ['before-after','beforeAfter','before_after'].includes(key);
const isArticle = ['blog','posts'].includes(key);
const isSlide = key === 'slider';
const isReview = key === 'testimonials';
const isArea = key === 'areas';
const gallery = Array.isArray(detail.gallery) ? detail.gallery : (Array.isArray(detail.images) ? detail.images : []);
const value = field => detail[field] == null ? '' : (Array.isArray(detail[field]) ? detail[field].join(', ') : detail[field]);
%>
<div class="page-heading"><div><p class="eyebrow"><%= collection.label %></p><h1><%= newRecord ? 'إضافة محتوى جديد' : 'تعديل المحتوى' %></h1><p class="muted">اهتم بالنصوص والصور لتظهر أعمالك بأفضل صورة.</p></div><a class="button button-outline" href="/admin/<%= key %>">العودة إلى القائمة</a></div>
<form class="editor-form" method="post" action="/admin/<%= key %>/save" enctype="multipart/form-data" data-json-form>
<input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="id" value="<%= item.id || '' %>">
<div class="editor-grid"><div class="editor-primary">
<section class="panel"><div class="panel-heading"><h2>المعلومات الأساسية</h2></div>
<label class="field"><span><%= isReview ? 'عنوان التقييم' : 'العنوان' %> <em>*</em></span><input name="title" maxlength="240" required value="<%= item.title || '' %>" placeholder="<%= isProject ? 'مثال: تجديد مجلس في شمال الرياض' : 'اكتب عنوانًا واضحًا' %>"></label>
<label class="field"><span>الوصف المختصر</span><textarea name="description" rows="3" maxlength="3000"><%= item.description || '' %></textarea></label>
<% if (!isReview && !isSlide) { %><label class="field"><span>رابط الصفحة (Slug)</span><input name="slug" dir="ltr" maxlength="160" pattern="[a-zA-Z0-9\u0600-\u06ff_-]+" value="<%= item.slug || '' %>" placeholder="interior-painting-riyadh"><small>حروف وأرقام وشرطات، دون مسافات. اتركه فارغًا لإنشائه تلقائيًا.</small></label><% } %>
<% if (!isSlide && !isReview && !['categories'].includes(key)) { %><label class="field"><span><%= isArticle ? 'محتوى المقال' : 'المحتوى التفصيلي' %></span><textarea name="content" rows="12" maxlength="100000" class="content-editor"><%= value('content') %></textarea><small>يُعرض كنص آمن. استخدم أسطرًا جديدة لفصل الفقرات.</small></label><% } %>
</section>
<% if (isProject || isBefore || isArea) { %>
<section class="panel"><div class="panel-heading"><h2><%= isArea ? 'معلومات المنطقة' : 'تفاصيل المشروع' %></h2></div><div class="form-grid">
<label class="field"><span>المنطقة</span><input name="area" value="<%= value('area') || 'الرياض' %>" maxlength="160"></label>
<label class="field"><span>الحي</span><input name="district" value="<%= value('district') %>" maxlength="160" placeholder="النرجس، الياسمين…"></label>
<% if (!isArea) { %><label class="field"><span>نوع الخدمة</span><input name="service" value="<%= value('service') %>" maxlength="180" placeholder="دهانات داخلية، جبس بورد…"></label><label class="field"><span>تاريخ التنفيذ</span><input name="projectDate" type="date" value="<%= value('projectDate') %>"></label><label class="field"><span>نوع العقار</span><input name="propertyType" value="<%= value('propertyType') %>" maxlength="100" placeholder="فيلا، شقة، مجلس"></label><label class="field"><span>تصنيفات المعرض</span><input name="tags" value="<%= value('tags') %>" maxlength="500" placeholder="دهانات, فلل, مجالس"><small>افصل التصنيفات بفاصلة.</small></label><% } %>
</div></section>
<% } %>
<% if (isProject || isBefore) { %>
<section class="panel"><div class="panel-heading"><h2>معرض الصور</h2><span class="muted">JPG · PNG · WebP · AVIF</span></div><label class="upload-zone"><span class="upload-icon" aria-hidden="true">＋</span><strong>أضف صور المشروع</strong><small>يمكن اختيار عدة صور</small><input name="images" type="file" accept="image/jpeg,image/png,image/webp,image/avif" multiple data-file-input></label><div class="file-list" data-file-list></div>
<label class="field"><span>روابط صور المعرض</span><textarea name="galleryUrls" dir="ltr" rows="4" placeholder="https://…&#10;https://…"><%= gallery.map(img => typeof img === 'string' ? img : img.image || img.url || '').join('\n') %></textarea><small>رابط لكل سطر. أبقِ الروابط التي تريد الاحتفاظ بها.</small></label>
<div class="form-grid comparison-inputs"><div><h3>صورة قبل التنفيذ</h3><% if (value('beforeImage')) { %><img class="media-preview" src="<%= value('beforeImage') %>" alt="قبل التنفيذ" loading="lazy"><% } %><label class="field"><span>رفع صورة قبل</span><input type="file" name="beforeImage" accept="image/jpeg,image/png,image/webp,image/avif" data-file-input></label><label class="field"><span>أو رابط الصورة</span><input name="beforeImageUrl" type="url" dir="ltr" value="<%= value('beforeImage') %>"></label></div>
<div><h3>صورة بعد التنفيذ</h3><% if (value('afterImage')) { %><img class="media-preview" src="<%= value('afterImage') %>" alt="بعد التنفيذ" loading="lazy"><% } %><label class="field"><span>رفع صورة بعد</span><input type="file" name="afterImage" accept="image/jpeg,image/png,image/webp,image/avif" data-file-input></label><label class="field"><span>أو رابط الصورة</span><input name="afterImageUrl" type="url" dir="ltr" value="<%= value('afterImage') %>"></label></div></div>
</section>
<% } %>
<% if (isSlide) { %><section class="panel"><div class="panel-heading"><h2>إعدادات الشريحة</h2></div><div class="form-grid"><label class="field"><span>مدة العرض (مللي ثانية)</span><input name="duration" type="number" min="4000" max="10000" step="500" value="<%= value('duration') || 5000 %>"><small>5000 = خمس ثوانٍ.</small></label><label class="field"><span>نص الزر</span><input name="buttonLabel" value="<%= value('buttonLabel') %>" maxlength="120"></label><label class="field field-span"><span>رابط الزر</span><input name="buttonUrl" dir="ltr" value="<%= value('buttonUrl') %>" maxlength="2000" placeholder="/quote أو https://…"></label></div></section><% } %>
<% if (isReview) { %><section class="panel"><div class="panel-heading"><h2>رأي العميل</h2></div><div class="form-grid"><label class="field"><span>اسم العميل</span><input name="clientName" value="<%= value('clientName') %>" maxlength="160"></label><label class="field"><span>المنطقة / الحي</span><input name="area" value="<%= value('area') %>" maxlength="160"></label><label class="field"><span>التقييم</span><select name="rating"><% [5,4,3,2,1].forEach(number => { %><option value="<%= number %>" <%= Number(value('rating') || 5) === number ? 'selected' : '' %>><%= number %> من 5</option><% }); %></select></label></div><p class="field-note">انشر آراء العملاء الحقيقية بعد موافقتهم. نص الرأي في حقل الوصف أعلاه.</p></section><% } %>
<% if (isArticle) { %><section class="panel"><div class="panel-heading"><h2>معلومات النشر</h2></div><label class="field"><span>اسم الكاتب</span><input name="author" value="<%= value('author') %>" maxlength="160"></label></section><% } %>
<% if (!isSlide && !isReview) { %><section class="panel"><div class="panel-heading"><h2>تحسين محركات البحث</h2><span class="small-tag tag-light">SEO</span></div><label class="field"><span>عنوان الصفحة (Meta Title)</span><input name="seoTitle" value="<%= value('seoTitle') %>" maxlength="200"><small>يفضّل عنوان واضح لا يتجاوز 60 حرفًا.</small></label><label class="field"><span>وصف الصفحة (Meta Description)</span><textarea name="metaDescription" rows="3" maxlength="500"><%= value('metaDescription') %></textarea><small>وصف مفيد ومختصر للخدمة أو المحتوى.</small></label><label class="field"><span>الكلمات المفتاحية</span><input name="keywords" value="<%= value('keywords') %>" maxlength="1500" placeholder="دهانات الرياض, ديكورات شمال الرياض"></label></section><% } %>
<details class="panel advanced-panel"><summary>خيارات متقدمة · بيانات JSON</summary><p class="muted">للحقول الإضافية. الحقول الظاهرة في النموذج لها الأولوية عند الحفظ.</p><label class="field"><span>بيانات المحتوى</span><textarea name="dataJSON" rows="12" dir="ltr" data-json-input><%= JSON.stringify(detail, null, 2) %></textarea></label></details>
</div><aside class="editor-aside">
<section class="panel"><div class="panel-heading"><h2>النشر</h2></div><label class="toggle-field"><span><strong>إظهار على الموقع</strong><small>أوقفه لحفظ المحتوى كمسودة.</small></span><input type="checkbox" name="enabled" value="1" <%= newRecord || item.enabled ? 'checked' : '' %>><span class="toggle-track" aria-hidden="true"></span></label><label class="field"><span>ترتيب العرض</span><input name="position" type="number" min="0" max="100000" value="<%= item.position || 0 %>"></label><button class="button button-primary full-width" type="submit" data-submit-label="جارٍ الحفظ…">حفظ التغييرات <span aria-hidden="true">✓</span></button><a class="button button-outline full-width cancel-link" href="/admin/<%= key %>">إلغاء</a></section>
<section class="panel"><div class="panel-heading"><h2>الصورة الرئيسية</h2></div><% if (item.image) { %><img class="media-preview" data-image-preview src="<%= item.image %>" alt="<%= item.title || 'الصورة الحالية' %>"><% } else { %><div class="image-placeholder" data-image-placeholder aria-hidden="true">◇</div><img class="media-preview" data-image-preview hidden alt="معاينة الصورة"><% } %><label class="field"><span>رفع صورة</span><input name="image" type="file" accept="image/jpeg,image/png,image/webp,image/avif" data-file-input data-preview-file></label><label class="field"><span>أو رابط الصورة</span><input name="imageUrl" type="url" dir="ltr" value="<%= item.image || '' %>" maxlength="2000" data-image-url></label><label class="field"><span>النص البديل للصورة</span><input name="alt" value="<%= value('alt') %>" maxlength="500" placeholder="وصف مختصر لمحتوى الصورة"></label><p class="field-note">استخدم صورًا واضحة لأعمالك. رفع صورة جديدة يستبدل الصورة الحالية.</p></section>
</aside></div></form>
<%- include('partials/footer') %>
