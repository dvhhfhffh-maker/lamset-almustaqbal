<%- include('partials/header', { pageTitle: collection.label }) %>
<div class="page-heading"><div><p class="eyebrow">إدارة المحتوى</p><h1><%= collection.label %></h1><p class="muted"><%= collection.key === 'slider' ? 'اختر صور الواجهة ورتّبها بالسحب. تظهر الصور المفعّلة فقط.' : 'أضف المحتوى وعدّله وتحكّم في ظهوره على الموقع.' %></p></div><a class="button button-primary" href="/admin/<%= collection.key %>/new">إضافة جديد <span aria-hidden="true">＋</span></a></div>
<section class="panel list-panel"><div class="list-toolbar"><div><strong><%= records.length.toLocaleString('ar-SA') %></strong> عنصر</div><label class="search-input"><span aria-hidden="true">⌕</span><input type="search" data-record-search placeholder="ابحث في المحتوى…" aria-label="البحث في المحتوى"></label></div>
<% if (!records.length) { %>
<div class="empty-state"><span class="empty-symbol" aria-hidden="true">◇</span><h2>مساحة لأعمالك القادمة</h2><p>ابدأ بإضافة أول عنصر إلى <%= collection.label %>.</p><a class="button button-primary" href="/admin/<%= collection.key %>/new">إضافة جديد ＋</a></div>
<% } else { %>
<div class="table-scroll"><table class="content-table"><thead><tr><% if (collection.key === 'slider') { %><th><span class="sr-only">الترتيب</span></th><% } %><th>المحتوى</th><th>الحالة</th><th>الترتيب</th><th>الإجراءات</th></tr></thead><tbody <%= collection.key === 'slider' ? 'data-sortable' : '' %> data-collection="<%= collection.key %>">
<% records.forEach(record => { %><tr data-record-row data-record-id="<%= record.id %>" data-search-text="<%= (record.title || '') + ' ' + (record.description || '') %>" <%= collection.key === 'slider' ? 'draggable=true' : '' %>>
<% if (collection.key === 'slider') { %><td class="drag-cell"><button type="button" class="drag-handle" aria-label="اسحب لتغيير ترتيب الصورة" title="اسحب لتغيير الترتيب">⠿</button><div class="order-buttons"><button type="button" data-order="up" aria-label="تحريك إلى أعلى">↑</button><button type="button" data-order="down" aria-label="تحريك إلى أسفل">↓</button></div></td><% } %>
<td><div class="record-info"><% if (record.image) { %><img src="<%= record.image %>" alt="<%= record.title || '' %>" loading="lazy" width="72" height="60"><% } else { %><span class="record-placeholder" aria-hidden="true">◇</span><% } %><div><a href="/admin/<%= collection.key %>/<%= record.id %>/edit"><strong><%= record.title || 'بدون عنوان' %></strong></a><p><%= (record.description || '').slice(0, 95) %></p><% if (record.slug) { %><small dir="ltr"><%= record.slug %></small><% } %></div></div></td>
<td><span class="status <%= record.enabled ? 'status-active' : 'status-draft' %>"><span aria-hidden="true">●</span> <%= record.enabled ? 'منشور' : 'مخفي' %></span></td><td data-position><%= Number(record.position || 0).toLocaleString('ar-SA') %></td>
<td><div class="table-actions"><a class="button button-small button-outline" href="/admin/<%= collection.key %>/<%= record.id %>/edit">تعديل</a><form method="post" action="/admin/<%= collection.key %>/<%= record.id %>/delete" data-confirm="هل تريد حذف هذا العنصر؟ لا يمكن التراجع عن الحذف."><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit" class="button button-small button-danger">حذف</button></form></div></td>
</tr><% }); %></tbody></table></div><div class="empty-search" data-empty-search hidden>لا توجد نتائج مطابقة لبحثك.</div>
<% } %>
<% if (collection.key === 'slider' && records.length > 1) { %><div class="sort-footer"><p class="muted">يمكنك استخدام أزرار ↑ و↓ لترتيب الصور من الجوال.</p><button class="button button-primary" type="button" data-save-order disabled>حفظ الترتيب</button></div><% } %>
</section>
<%- include('partials/footer') %>
