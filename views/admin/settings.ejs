<%- include('partials/header', { pageTitle: 'الإعدادات العامة' }) %>
<% const site = settings || {}; const jsonValue = value => typeof value === 'string' ? value : JSON.stringify(value || [], null, 2); %>
<div class="page-heading"><div><p class="eyebrow">هوية الموقع ومعلوماته</p><h1>الإعدادات العامة</h1><p class="muted">كل التفاصيل التي تجعل الموقع يعكس نشاطك.</p></div></div>
<form action="/admin/settings" method="post" enctype="multipart/form-data" data-json-form>
<input type="hidden" name="_csrf" value="<%= csrfToken %>">
<div class="editor-grid"><div class="editor-primary">
<section class="panel"><div class="panel-heading"><h2>معلومات النشاط</h2></div><div class="form-grid">
<label class="field"><span>اسم الموقع <em>*</em></span><input name="businessName" required value="<%= site.businessName || '' %>" maxlength="160"></label>
<label class="field"><span>رابط الموقع الرسمي</span><input name="siteUrl" type="url" dir="ltr" value="<%= site.siteUrl || '' %>" placeholder="https://example.com" maxlength="2000"><small>يُستخدم للروابط الأساسية وملف خريطة الموقع.</small></label>
<label class="field field-span"><span>وصف النشاط</span><textarea name="description" rows="3" maxlength="4000"><%= site.description || '' %></textarea></label>
<label class="field"><span>رقم الاتصال</span><input name="phone" type="tel" dir="ltr" value="<%= site.phone || '' %>" maxlength="30" placeholder="+966501308295"></label>
<label class="field"><span>رقم واتساب</span><input name="whatsapp" type="tel" dir="ltr" value="<%= site.whatsapp || '' %>" maxlength="30" placeholder="966501308295"><small>الرقم الدولي دون مسافات.</small></label>
<label class="field"><span>البريد الإلكتروني</span><input name="email" type="email" dir="ltr" value="<%= site.email || '' %>" maxlength="254"></label>
<label class="field"><span>عنوان النشاط الرسمي</span><input name="address" value="<%= site.address || '' %>" maxlength="500"><small>اتركه فارغًا إذا لم يوجد عنوان رسمي.</small></label>
<label class="field field-span"><span>رابط خرائط Google</span><input name="mapsUrl" type="url" dir="ltr" value="<%= site.mapsUrl || '' %>" maxlength="2000"><small>أضفه عند توفر موقع رسمي للنشاط.</small></label>
</div></section>
<section class="panel"><div class="panel-heading"><h2>نصوص الواجهة الرئيسية</h2></div><label class="field"><span>العنوان الرئيسي</span><input name="heroTitle" value="<%= site.heroTitle || '' %>" maxlength="240"></label><label class="field"><span>العنوان الفرعي</span><input name="heroSubtitle" value="<%= site.heroSubtitle || '' %>" maxlength="500"></label><label class="field"><span>الوصف</span><textarea name="heroDescription" rows="3" maxlength="2000"><%= site.heroDescription || '' %></textarea></label></section>
<section class="panel"><div class="panel-heading"><h2>هوية الموقع</h2></div><div class="form-grid">
<div><h3>الشعار</h3><% if (site.logo) { %><img class="logo-preview" src="<%= site.logo %>" alt="شعار النشاط" loading="lazy"><% } %><label class="field"><span>رفع الشعار</span><input name="logoUpload" type="file" accept="image/jpeg,image/png,image/webp,image/avif" data-file-input></label><label class="field"><span>رابط الشعار</span><input name="logo" dir="ltr" type="text" inputmode="url" value="<%= site.logo || '' %>" maxlength="2000"></label></div>
<div><h3>أيقونة الموقع</h3><% if (site.favicon) { %><img class="favicon-preview" src="<%= site.favicon %>" alt="أيقونة الموقع" loading="lazy"><% } %><label class="field"><span>رفع الأيقونة</span><input name="faviconUpload" type="file" accept="image/png,image/webp,image/avif" data-file-input></label><label class="field"><span>رابط الأيقونة</span><input name="favicon" dir="ltr" type="text" inputmode="url" value="<%= site.favicon || '' %>" maxlength="2000"></label></div>
<label class="field"><span>اللون الأساسي</span><div class="color-field"><input name="accentColor" type="color" value="<%= /^#[0-9a-f]{6}$/i.test(site.accentColor || '') ? site.accentColor : '#a58b65' %>"><span>لون الأزرار والتفاصيل البصرية</span></div></label></div></section>
<section class="panel"><div class="panel-heading"><h2>محركات البحث والمشاركة</h2><span class="small-tag tag-light">SEO</span></div>
<label class="field"><span>عنوان الموقع (Meta Title)</span><input name="metaTitle" value="<%= site.metaTitle || '' %>" maxlength="200"></label><label class="field"><span>وصف الموقع (Meta Description)</span><textarea name="metaDescription" rows="3" maxlength="500"><%= site.metaDescription || '' %></textarea></label>
<label class="field"><span>صورة المشاركة (Open Graph)</span><input name="shareUpload" type="file" accept="image/jpeg,image/png,image/webp,image/avif" data-file-input></label><label class="field"><span>رابط صورة المشاركة</span><input name="ogImage" type="text" inputmode="url" dir="ltr" value="<%= site.ogImage || '' %>" maxlength="2000"></label>
<% if (site.ogImage) { %><img class="media-preview share-preview" src="<%= site.ogImage %>" alt="صورة مشاركة الموقع" loading="lazy"><% } %>
</section>
<section class="panel"><div class="panel-heading"><h2>الإحصائيات</h2></div><label class="toggle-field"><span><strong>عرض قسم الإحصائيات</strong><small>فعّله بعد إدخال أرقامك الموثّقة.</small></span><input name="statsEnabled" type="checkbox" value="1" <%= site.statsEnabled ? 'checked' : '' %>><span class="toggle-track" aria-hidden="true"></span></label><p class="field-note">أضف القيم الحقيقية فقط. مثال البنية: [{ "value": 25, "label": "مشروع مكتمل", "suffix": "+" }]</p><label class="field"><span>بيانات الإحصائيات (JSON)</span><textarea name="stats" rows="7" dir="ltr" data-json-input><%= jsonValue(site.stats) %></textarea></label></section>
<section class="panel"><div class="panel-heading"><h2>روابط التواصل الاجتماعي</h2></div><p class="field-note">أضف الروابط الرسمية. مثال: [{ "label": "Instagram", "url": "https://instagram.com/…" }]</p><label class="field"><span>الروابط (JSON)</span><textarea name="socialLinks" rows="6" dir="ltr" data-json-input><%= jsonValue(site.socialLinks) %></textarea></label></section>
<details class="panel advanced-panel"><summary>خيارات متقدمة · جميع إعدادات الموقع</summary><p class="muted">يمكن تعديل النصوص والخيارات الإضافية هنا. الحقول الظاهرة أعلاه لها الأولوية عند الحفظ.</p><label class="field"><span>الإعدادات الكاملة (JSON)</span><textarea name="settingsJSON" rows="18" dir="ltr" data-json-input><%= JSON.stringify(site, null, 2) %></textarea></label></details>
</div><aside class="editor-aside"><section class="panel"><div class="panel-heading"><h2>حفظ الإعدادات</h2></div><p class="muted">تُطبّق التغييرات على الموقع بعد الحفظ.</p><button class="button button-primary full-width" type="submit" data-submit-label="جارٍ الحفظ…">حفظ التغييرات ✓</button><a class="button button-outline full-width cancel-link" href="/" target="_blank" rel="noopener">معاينة الموقع ↗</a></section><section class="panel tip-panel"><span class="tip-icon" aria-hidden="true">◇</span><h3>تفاصيل تعكس هويتك</h3><p>حافظ على وضوح معلومات التواصل وحداثة الصور. اختر صورة مشاركة تعكس جودة أعمالك.</p></section></aside></div>
</form>
<%- include('partials/footer') %>
