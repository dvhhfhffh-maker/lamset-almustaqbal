<%- include('partials/header', { pageTitle: 'طلبات العملاء' }) %>
<% const isQuotes = type === 'quotes'; const stateLabels = { new: 'جديد', contacted: 'تم التواصل', quoted: 'تم إرسال العرض', completed: 'مكتمل', closed: 'مغلق' }; %>
<div class="page-heading"><div><p class="eyebrow">تواصل يبني الثقة</p><h1>طلبات العملاء</h1><p class="muted">تابع الطلبات الجديدة وتفاصيل العمل المطلوب.</p></div></div>
<div class="page-tabs"><a class="<%= isQuotes ? 'is-active' : '' %>" href="/admin/requests?type=quotes">طلبات عرض السعر</a><a class="<%= !isQuotes ? 'is-active' : '' %>" href="/admin/requests?type=contacts">رسائل التواصل</a></div>
<section class="panel list-panel"><div class="list-toolbar"><div><strong><%= requests.length.toLocaleString('ar-SA') %></strong> طلب</div><label class="search-input"><span aria-hidden="true">⌕</span><input type="search" data-record-search placeholder="ابحث بالاسم أو الهاتف…" aria-label="البحث في الطلبات"></label></div>
<% if (!requests.length) { %><div class="empty-state"><span class="empty-symbol" aria-hidden="true">▤</span><h2>لا توجد طلبات بعد</h2><p>ستظهر طلبات العملاء هنا عند إرسالها من الموقع.</p></div><% } else { %><div class="table-scroll"><table class="content-table"><thead><tr><th>العميل</th><th><%= isQuotes ? 'الخدمة / الحي' : 'الرسالة' %></th><th>تاريخ الطلب</th><th>الحالة</th><th>التفاصيل</th></tr></thead><tbody><% requests.forEach(request => { const info = request.data || {}; %><tr data-record-row data-search-text="<%= [info.name,info.phone,info.service,info.district].filter(Boolean).join(' ') %>"><td><strong><%= info.name || 'عميل' %></strong><p class="table-sub" dir="ltr"><%= info.phone || '' %></p></td><td><%= isQuotes ? info.service || 'غير محدد' : (info.message || info.description || '').slice(0,70) %><% if (isQuotes && info.district) { %><p class="table-sub"><%= info.district %></p><% } %></td><td><%= request.createdAt ? new Date(request.createdAt).toLocaleDateString('ar-SA', {year:'numeric',month:'short',day:'numeric'}) : '—' %></td><td><span class="status <%= request.status === 'new' ? 'status-new' : 'status-active' %>"><%= stateLabels[request.status] || request.status || 'جديد' %></span></td><td><a class="button button-small button-outline" href="/admin/requests/<%= type %>/<%= request.id %>">عرض الطلب ←</a></td></tr><% }); %></tbody></table></div><div class="empty-search" data-empty-search hidden>لا توجد نتائج مطابقة لبحثك.</div><% } %></section>
<%- include('partials/footer') %>
