<section class="section journal-section"><div class="container"><div class="section-heading" data-reveal><div><p class="eyebrow">من مدونتنا</p><h2>إلهام لمنزل أكثر جمالًا</h2></div><% if(view==='home') { %><a class="text-link" href="/blog">المزيد من الأفكار <span class="small-rule"></span></a><% } %></div><div class="journal-grid"><% (view==='home'?posts.slice(0,3):posts).forEach(post=>{ %><article class="journal-card" data-reveal><a href="/blog/<%= post.slug %>" class="journal-image" tabindex="-1" aria-hidden="true"><img src="<%= post.image %>" alt="<%= post.data.alt || post.title %>" width="850" height="550" loading="lazy" decoding="async"></a><div class="journal-info"><p class="eyebrow">أفكار ونصائح<% if(post.data.date) { %> · <time datetime="<%= post.data.date %>"><%= new Intl.DateTimeFormat('ar-SA',{year:'numeric',month:'long',day:'numeric',calendar:'gregory'}).format(new Date(post.data.date)) %></time><% } %></p><h3><a href="/blog/<%= post.slug %>"><%= post.title %></a></h3><p><%= post.description %></p><a class="card-link" href="/blog/<%= post.slug %>">قراءة المقال <span></span></a></div></article><% }) %></div></div></section>