<section class="hero" data-carousel aria-label="صور الدهانات والديكور" aria-roledescription="عرض شرائح">
<div class="hero-images">
<% slides.forEach((slide,i)=> { %><div class="hero-slide <%= i===0?'is-active':'' %>" data-slide data-duration="<%= slide.data.duration || 5000 %>" aria-hidden="<%= i!==0 %>">
<img <%- i===0?'src':'data-src' %>="<%= slide.image %>" alt="<%= slide.data.alt || slide.title %>" <%- i===0?'srcset':'data-srcset' %>="<%= srcsetFor(slide.image) %>" width="1920" height="1280" <%- i===0?'fetchpriority="high" loading="eager"':'loading="lazy"' %> decoding="async" sizes="100vw">
<div class="hero-slide-caption"><span><%= slide.title %></span><% if(slide.data.buttonUrl) { %><a href="<%= slide.data.buttonUrl %>"><%= slide.data.buttonText || 'اكتشف المزيد' %></a><% } %></div>
</div><% }) %>
</div><div class="hero-shade"></div>
<div class="container hero-content">
<p class="eyebrow hero-eyebrow"><span></span> تفاصيل تصنع الفرق</p>
<h1><%= settings.heroTitle %></h1>
<p class="hero-subtitle"><%= settings.heroSubtitle %></p>
<p class="hero-description"><%= settings.heroDescription %></p>
<div class="hero-actions"><a class="button button-gold" href="<%= waUrl %>" target="_blank" rel="noopener noreferrer"><%- include('icon',{name:'whatsapp'}) %> تواصل عبر واتساب</a><a class="button button-outline-light" href="<%= telUrl %>"><%- include('icon',{name:'phone'}) %> اتصل الآن</a></div>
<p class="hero-location"><%- include('icon',{name:'pin'}) %> الرياض، شمال الرياض وجميع أحيائها</p>
</div>
<div class="container hero-bottom">
<a href="#services" class="hero-scroll">اكتشف لمسة المستقبل <span class="scroll-line"></span></a>
<% if(slides.length>1) { %><div class="hero-controls">
<div class="hero-dots" aria-label="اختر صورة"><% slides.forEach((slide,i)=> { %><button data-carousel-dot data-index="<%= i %>" class="<%= i===0?'is-active':'' %>" aria-label="عرض الصورة <%= i+1 %>" aria-current="<%= i===0?'true':'false' %>"></button><% }) %></div>
<span class="slide-count" dir="ltr"><b data-slide-current>01</b><i>/</i><%= String(slides.length).padStart(2,'0') %></span>
<button class="icon-button hero-control" data-carousel-prev aria-label="الصورة السابقة"><%- include('icon',{name:'next'}) %></button>
<button class="icon-button hero-control" data-carousel-next aria-label="الصورة التالية"><%- include('icon',{name:'chevron'}) %></button>
<button class="icon-button hero-control pause-control" data-carousel-pause aria-label="إيقاف العرض التلقائي"><%- include('icon',{name:'pause'}) %><span class="sr-only" data-carousel-pause-label>إيقاف العرض التلقائي</span></button>
</div><% } %></div>
<p class="sr-only" data-carousel-status aria-live="polite"></p>
</section>
<section class="signature-strip"><div class="container signature-inner">
<p>مساحة تشبهك.<br><strong>وتفاصيل تستحقها.</strong></p>
<div><%- include('icon',{name:'shield'}) %><span>جودة في التنفيذ<small>من التحضير إلى آخر لمسة</small></span></div>
<div><%- include('icon',{name:'clock'}) %><span>خطوات واضحة<small>معاينة، تخطيط، تنفيذ</small></span></div>
<div><%- include('icon',{name:'sparkle'}) %><span>عناية بالتفاصيل<small>ألوان وخامات في تناغم</small></span></div>
</div></section>