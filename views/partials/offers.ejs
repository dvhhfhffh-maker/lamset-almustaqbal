<% if(offers.length) { %><section class="section offers-section" aria-label="العروض الحالية"><div class="container offers-grid"><% offers.forEach(offer=>{ %><article class="offer-card" data-reveal><% if(offer.image) { %><img src="<%= offer.image %>" srcset="<%= srcsetFor(offer.image) %>" sizes="(max-width: 700px) calc(100vw - 32px), 30vw" alt="<%= offer.data.alt || offer.title %>" loading="lazy" decoding="async" width="800" height="500"><% } %><div><p class="eyebrow">عرض من لمسة المستقبل</p><h2><%= offer.title %></h2><p><%= offer.description %></p><a class="button button-dark" href="<%= offer.data.buttonUrl || '/quote' %>"><%= offer.data.buttonText || 'استفسر عن العرض' %></a></div></article><% }) %></div></section><% } %>