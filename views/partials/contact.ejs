<section class="section contact-section"><div class="container contact-layout"><div class="contact-details" data-reveal><p class="eyebrow">قريبون من تفاصيلك</p><h2>لنتحدث عن منزلك.</h2><p>سواء كانت فكرتك واضحة أو ما زلت تبحث عن البداية، يسعدنا مساعدتك.</p>
<a class="contact-line" href="<%= telUrl %>"><span><%- include('icon',{name:'phone'}) %></span><div><small>اتصال مباشر</small><strong dir="ltr"><%= settings.phone %></strong></div></a>
<a class="contact-line" href="<%= waUrl %>" target="_blank" rel="noopener noreferrer"><span><%- include('icon',{name:'whatsapp'}) %></span><div><small>واتساب</small><strong>أرسل تفاصيل مشروعك</strong></div></a>
<div class="contact-line"><span><%- include('icon',{name:'pin'}) %></span><div><small>نطاق الخدمة</small><strong><%= settings.address || 'الرياض – شمال الرياض' %></strong><p>وجميع أحياء مدينة الرياض</p></div></div>
<% if(settings.email) { %><a class="contact-line" href="mailto:<%= settings.email %>"><span><%- include('icon',{name:'mail'}) %></span><div><small>البريد الإلكتروني</small><strong dir="ltr"><%= settings.email %></strong></div></a><% } %>
<% if(settings.mapUrl && /^https:\/\/(www\.)?google\.com\/maps\//.test(settings.mapUrl)) { %><a class="text-link" href="<%= settings.mapUrl %>" target="_blank" rel="noopener noreferrer">عرض الموقع على خرائط Google</a><% } %>
</div><div class="form-card" data-reveal><h2>اترك لنا رسالة</h2><% if(flash) { %><div class="form-success" role="status"><%- include('icon',{name:'check'}) %><p><%= flash %></p></div><% } %><% if(errors && errors.length) { %><div class="form-errors" role="alert"><ul><% errors.forEach(error=>{ %><li><%= typeof error==='string'?error:error.message %></li><% }) %></ul></div><% } %><% const values=typeof formValues!=='undefined' && formValues?formValues:{}; %>
<form action="/contact" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="field"><label for="contact-name">الاسم</label><input id="contact-name" name="name" autocomplete="name" required maxlength="120" placeholder="اسمك الكريم" value="<%= values.name || '' %>"></div><div class="field"><label for="contact-phone">رقم الهاتف</label><input id="contact-phone" name="phone" type="tel" inputmode="tel" autocomplete="tel" dir="ltr" data-phone required maxlength="30" placeholder="05xxxxxxxx" value="<%= values.phone || '' %>"></div><div class="field"><label for="contact-message">رسالتك</label><textarea id="contact-message" name="message" required minlength="10" maxlength="6000" rows="5" placeholder="كيف يمكننا مساعدتك؟"><%= values.message || '' %></textarea></div><button type="submit" class="button button-dark form-submit" data-submit>إرسال الرسالة <%- include('icon',{name:'mail'}) %></button></form>
</div></div></section>