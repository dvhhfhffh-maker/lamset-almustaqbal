<section class="section quote-section" id="quote"><div class="container quote-layout">
<div class="quote-intro" data-reveal><p class="eyebrow">طلب عرض سعر</p><h2>خطوتك الأولى<br>نحو مساحة أجمل.</h2><p>شاركنا تفاصيل العمل، لنناقش معك احتياجات المساحة ونرتب المعاينة عند الحاجة.</p><ul class="quiet-list"><li><%- include('icon',{name:'check'}) %> عرض يناسب نطاق العمل والخامات</li><li><%- include('icon',{name:'check'}) %> تواصل مباشر وواضح</li><li><%- include('icon',{name:'check'}) %> نخدم الرياض وجميع أحيائها</li></ul><a class="quote-phone" href="<%= telUrl %>"><span class="quote-phone-icon"><%- include('icon',{name:'phone'}) %></span><span>تفضّل الحديث مباشرة؟<strong dir="ltr"><%= settings.phone %></strong></span></a></div>
<div class="form-card" data-reveal>
<% if(flash) { %><div class="form-success" role="status"><%- include('icon',{name:'check'}) %><div><strong>تم استلام طلبك</strong><p><%= flash %></p><a href="<%= waUrl %>" target="_blank" rel="noopener noreferrer">تابع معنا عبر واتساب</a></div></div><% } %>
<% if(errors && errors.length) { %><div class="form-errors" role="alert"><strong>يرجى مراجعة البيانات التالية:</strong><ul><% errors.forEach(error=>{ %><li><%= typeof error==='string'?error:error.message %></li><% }) %></ul></div><% } %>
<% const values=typeof formValues!=='undefined' && formValues ? formValues : {}; %>
<form action="/quote" method="post" enctype="multipart/form-data" data-quote-form data-whatsapp="<%= settings.whatsapp %>">
<input type="hidden" name="_csrf" value="<%= csrfToken %>">
<div class="form-grid">
<div class="field"><label for="quote-name">الاسم <span>*</span></label><input id="quote-name" name="name" autocomplete="name" placeholder="اسمك الكريم" required maxlength="120" value="<%= values.name || '' %>"></div>
<div class="field"><label for="quote-phone">رقم الهاتف <span>*</span></label><input id="quote-phone" name="phone" type="tel" inputmode="tel" dir="ltr" autocomplete="tel" data-phone placeholder="05xxxxxxxx" required maxlength="30" value="<%= values.phone || '' %>"></div>
<div class="field"><label for="quote-whatsapp">رقم واتساب</label><input id="quote-whatsapp" name="whatsapp" type="tel" inputmode="tel" dir="ltr" data-phone placeholder="إذا كان مختلفًا عن رقم الهاتف" maxlength="30" value="<%= values.whatsapp || '' %>"></div>
<div class="field"><label for="quote-area">المنطقة <span>*</span></label><select id="quote-area" name="area" required><option value="الرياض" <%= values.area==='الرياض'?'selected':'' %>>الرياض</option><option value="شمال الرياض" <%= values.area==='شمال الرياض'?'selected':'' %>>شمال الرياض</option></select></div>
<div class="field"><label for="quote-district">الحي <span>*</span></label><input id="quote-district" name="district" list="districts" placeholder="مثال: النرجس" required maxlength="100" value="<%= values.district || '' %>"><datalist id="districts"><% areas.forEach(area=>{ %><option value="<%= area.title %>"><% }) %></datalist></div>
<div class="field"><label for="quote-service">نوع الخدمة <span>*</span></label><select id="quote-service" name="service" required><option value="">اختر الخدمة</option><% services.forEach(service=>{ %><option value="<%= service.title %>" <%= values.service===service.title?'selected':'' %>><%= service.title %></option><% }) %></select></div>
<div class="field"><label for="quote-property">نوع العقار <span>*</span></label><select id="quote-property" name="propertyType" required><option value="">اختر نوع العقار</option><% ['فيلا','شقة','منزل','مجلس','أخرى'].forEach(type=>{ %><option value="<%= type %>" <%= values.propertyType===type?'selected':'' %>><%= type %></option><% }) %></select></div>
<div class="field"><label for="quote-budget">الميزانية التقريبية <small>اختياري</small></label><input id="quote-budget" name="budget" placeholder="الميزانية بالريال السعودي" maxlength="100" value="<%= values.budget || '' %>"></div>
<div class="field field-full"><label for="quote-description">وصف العمل <span>*</span></label><textarea id="quote-description" name="description" rows="4" required minlength="10" maxlength="5000" placeholder="أخبرنا بالمساحة، والخدمة المطلوبة، وما ترغب في تغييره…"><%= values.description || '' %></textarea></div>
<div class="field field-full"><label for="quote-photos">صور المساحة <small>اختياري</small></label><div class="upload-field"><%- include('icon',{name:'upload'}) %><span>أضف صورًا تساعدنا على فهم العمل<small>حتى 6 صور · 5 ميجابايت لكل صورة · JPG، PNG، WebP، AVIF</small></span><input id="quote-photos" type="file" name="photos" accept="image/jpeg,image/png,image/webp,image/avif" multiple data-photo-input></div><div class="file-list" data-file-list aria-live="polite"></div></div>
</div><button class="button button-dark form-submit" type="submit" data-submit>إرسال طلب عرض السعر <%- include('icon',{name:'quote'}) %></button><button class="form-whatsapp-preview" type="button" data-quote-whatsapp data-whatsapp="<%= settings.whatsapp %>"><%- include('icon',{name:'whatsapp'}) %> مشاركة التفاصيل عبر واتساب</button><p class="form-note">إرسال النموذج يحفظ الطلب لدينا. مشاركة التفاصيل عبر واتساب تفتح محادثة منفصلة؛ يمكنك إرفاق الصور داخلها.</p>
</form></div></div></section>