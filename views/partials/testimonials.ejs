<% if(testimonials.length) { %><section class="section testimonials-section"><div class="container"><div class="section-heading"><div><p class="eyebrow">آراء العملاء</p><h2>ثقة تُبنى، وتجربة تُروى</h2></div></div><div class="testimonials-slider" data-testimonials aria-roledescription="عرض تقييمات"><div class="testimonials-track">
<% testimonials.forEach((review,i)=> { %><article class="testimonial <%= i===0?'is-active':'' %>" data-testimonial <%- i?'hidden':'' %>><span class="quote-mark"><%- include('icon',{name:'quote'}) %></span><div class="review-stars" aria-label="التقييم <%= review.data.rating || 5 %> من 5"><% for(let j=0;j<Number(review.data.rating || 5);j++) { %><%- include('icon',{name:'star'}) %><% } %></div><blockquote><%= review.description %></blockquote><div class="review-person"><span class="avatar"><%= review.title.slice(0,1) %></span><div><h3><%= review.title %></h3><p><%= review.data.area || review.data.district || '' %></p></div></div></article><% }) %>
</div><div class="testimonial-controls"><button class="icon-button" data-testimonial-prev aria-label="التقييم السابق"><%- include('icon',{name:'next'}) %></button><% testimonials.forEach((_,i)=> { %><button class="testimonial-dot <%= i===0?'is-active':'' %>" data-testimonial-dot data-index="<%= i %>" aria-label="التقييم <%= i+1 %>"></button><% }) %><button class="icon-button" data-testimonial-next aria-label="التقييم التالي"><%- include('icon',{name:'chevron'}) %></button><button class="icon-button" data-testimonial-pause aria-label="إيقاف عرض التقييمات تلقائيًا"><%- include('icon',{name:'pause'}) %></button><span class="sr-only" data-testimonial-current aria-live="polite">1</span></div></div></div></section><% } else if(view==='testimonials') { %><section class="section"><div class="container empty-state"><span class="empty-icon"><%- include('icon',{name:'quote'}) %></span><h2>كل تجربة تستحق أن تُسمع</h2><p>ننشر آراء العملاء بعد موافقتهم والتحقق منها. إذا استفدت من خدماتنا، يسعدنا سماع تجربتك.</p><a class="button button-dark" href="<%= waUrl %>" target="_blank" rel="noopener noreferrer">شاركنا تجربتك عبر واتساب</a></div></section><% } %>